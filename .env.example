# ==============================================================================
# تنظیمات Samad Food Monitor — سامانه تغذیه دانشگاه شهید بهشتی (سماد)
# راهنما: این فایل را به نام .env کپی کرده و مقادیر مورد نظر خود را وارد کنید.
# هشدار امنیتی: هرگز نام کاربری یا رمز عبور سماد را در این فایل قرار ندهید!
# ورود به سماد صرفاً به‌صورت دستی با دستور `python -m samad_monitor login` انجام می‌شود.
# ==============================================================================

# --- مشخصات سامانه سماد (دانشگاه شهید بهشتی) ---
SAMAD_WEB_URL=https://samad.app
SAMAD_RESERVE_URL=https://samad.app/food/reserve
SAMAD_UNIVERSITY_KEY=SBU
SAMAD_UNIVERSITY_LABEL=دانشگاه شهید بهشتی
SAMAD_UNIVERSITY_API_URL=https://dining.sbu.ac.ir

# استراتژی واکشی اطلاعات:
# auto    : اولویت با API رسمی مشاهده‌شده سماد + بازگشت خودکار به مرورگر Headless در صورت نیاز (پیشنهادی)
# api     : فقط استفاده از API رسمی مشاهده‌شده با توکن نشست کاربر
# browser : باز کردن صفحه رزرو با Playwright در حالت Headless و استخراج از Network/DOM
SAMAD_FETCH_STRATEGY=auto

# فیلتر اختیاری سلف‌ها (خالی = بررسی تمام سلف‌های تغذیه فعال دانشجو)
# مثال شناسه عددی با کاما: SAMAD_SELF_IDS=1,2
SAMAD_SELF_IDS=
# مثال فیلتر متنی نام سلف با کاما: SAMAD_SELF_NAME_FILTER=مرکزی,خوابگاه
SAMAD_SELF_NAME_FILTER=

# نادیده گرفتن پروکسی/VPN سیستم برای اتصال مستقیم به سرور داخلی سماد دانشگاه شهید بهشتی
SAMAD_IGNORE_ENV_PROXY=true
SAMAD_PROXY_URL=

# --- تنظیمات زمان‌بندی پایش (بر مبنای ساعت تهران Asia/Tehran) ---
SAMAD_TIMEZONE=Asia/Tehran
# فاصله بررسی در روزهای عادی هفته (شنبه تا چهارشنبه) — به دقیقه
CHECK_INTERVAL_NORMAL_MINUTES=60
# فاصله بررسی در روزهای پایانی هفته (پنجشنبه و جمعه) — به دقیقه
CHECK_INTERVAL_PEAK_MINUTES=12
# مقدار Jitter تصادفی (ثانیه) برای جلوگیری از الگوی ثابت درخواست‌ها
CHECK_JITTER_SECONDS=45
# تأخیر محترمانه بین بررسی چند سلف (ثانیه)
REQUEST_MIN_INTERVAL_SECONDS=1.2
# مهلت زمانی هر درخواست شبکه (ثانیه) و تعداد تلاش مجدد در خطاهای موقت
HTTP_TIMEOUT_SECONDS=25
MAX_RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=2.0

# --- تنظیمات مسیر فایل‌های محلی ---
DATA_DIR=data
LOGS_DIR=logs
SQLITE_DB_PATH=data/samad_monitor.db
BROWSER_PROFILE_DIR=data/browser_profile
STORAGE_STATE_PATH=data/storage_state.json
LOGIN_TIMEOUT_SECONDS=300

# --- تنظیمات اعلان تلگرام (Telegram Bot API) ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# یک یا چند Chat ID جداشده با کاما (مثلاً 123456789)
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
# پروکسی اختصاصی برای اتصال به تلگرام از ایران (مثال: socks5://127.0.0.1:10808 یا http://127.0.0.1:12334)
TELEGRAM_PROXY_URL=
# عضویت خودکار افراد جدید هنگام ارسال /start به ربات تلگرام (true / false)
TELEGRAM_AUTO_SUBSCRIBE=false
# کد دعوت اختیاری برای عضویت خودکار (مثال: sbu1405 — اگر خالی باشد هر کسی که /start بزند عضو می‌شود)
TELEGRAM_INVITE_CODE=

# --- تنظیمات اعلان دسکتاپ ویندوز ۱۱ ---
WINDOWS_NOTIFICATION_ENABLED=true
WINDOWS_NOTIFICATION_SOUND=true

# --- سطح ثبت گزارش (DEBUG, INFO, WARNING, ERROR) ---
LOG_LEVEL=INFO
